# ==============================================================================
# D4UC (Discord Username Checker) Environment Configuration Example
# Copy this file to .env and fill in your private settings.
# ==============================================================================

# 1. Surfshark WireGuard Private Keys (Comma-separated for multi-key round-robin)
SURFSHARK_PRIVATE_KEYS=YOUR_SURFSHARK_WIREGUARD_PRIVATE_KEY_HERE

# 2. Surfshark OpenVPN Manual Credentials (Optional)
SURFSHARK_OPENVPN_USER=YOUR_OPENVPN_USERNAME_HERE
SURFSHARK_OPENVPN_PASS=YOUR_OPENVPN_PASSWORD_HERE

# 3. Headless & Docker Mode Configuration
D4UC_MODE=hybrid            # hybrid, permutation, dictionary, pattern, numeric, random
D4UC_LENGTH=4               # 3, 4, 5, 6
D4UC_WORKERS=5              # 1 - 50 concurrent workers
D4UC_PROXY=surfshark        # surfshark, file, thordata, direct
D4UC_SHARD=                 # e.g. 2_1, 2_2, 3_1, 3_2, 4_1 (for multi-container acceleration)
D4UC_NO_DASHBOARD=1         # 1: streaming stdout logs, 0: full TUI dashboard

# 4. Realtime Notifications (Optional)
D4UC_WEBHOOK=               # https://discord.com/api/webhooks/...
